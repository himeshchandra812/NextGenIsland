<Window x:Class="NextGenIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextGen Island" Width="680" Height="330"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>

        <!-- Icon-only navigation tab -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Hover" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round icon button (prev / next / pin / settings / bell) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain transport glyph (prev / play / next): no disc, white, soft hover -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="20" Background="Transparent">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Large play / pause disc. Background is set on the element so the accent can animate. -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" CornerRadius="22" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big round mic disc -->
        <Style x:Key="MicDisc" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" CornerRadius="32" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent pill button -->
        <Style x:Key="GlassPill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Icon geometries (24x24 grid) -->
        <Geometry x:Key="IconMusic">M9,17.5 L9,5.5 L19,3.5 L19,15.5 M9,17.5 A2.5,2.5 0 1 1 4,17.5 A2.5,2.5 0 1 1 9,17.5 M19,15.5 A2.5,2.5 0 1 1 14,15.5 A2.5,2.5 0 1 1 19,15.5</Geometry>
        <Geometry x:Key="IconBell">M6,10 A6,6 0 0 1 18,10 C18,14.5 20,15.5 20,17 L4,17 C4,15.5 6,14.5 6,10 Z M10,20.5 A2,2 0 0 0 14,20.5</Geometry>
        <Geometry x:Key="IconSystem">M7,7 L17,7 L17,17 L7,17 Z M10.5,10.5 L13.5,10.5 L13.5,13.5 L10.5,13.5 Z M9.5,3.5 L9.5,7 M14.5,3.5 L14.5,7 M9.5,17 L9.5,20.5 M14.5,17 L14.5,20.5 M3.5,9.5 L7,9.5 M3.5,14.5 L7,14.5 M17,9.5 L20.5,9.5 M17,14.5 L20.5,14.5</Geometry>
        <Geometry x:Key="IconClipboard">M9,3.5 L15,3.5 L15,6.5 L9,6.5 Z M9,5 L7,5 A1.5,1.5 0 0 0 5.5,6.5 L5.5,19.5 A1.5,1.5 0 0 0 7,21 L17,21 A1.5,1.5 0 0 0 18.5,19.5 L18.5,6.5 A1.5,1.5 0 0 0 17,5 L15,5 M9,12 L15,12 M9,16 L13,16</Geometry>
        <Geometry x:Key="IconAlarm">M12,6 A7.5,7.5 0 1 1 12,21 A7.5,7.5 0 1 1 12,6 Z M12,10 L12,13.5 L14.5,15 M4.5,6 L7.5,3.5 M19.5,6 L16.5,3.5</Geometry>
        <Geometry x:Key="IconShelf">M4,14.5 L4,18.5 A1.5,1.5 0 0 0 5.5,20 L18.5,20 A1.5,1.5 0 0 0 20,18.5 L20,14.5 M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5</Geometry>
        <Geometry x:Key="IconSparkle">M12,3 C12,8 14,10 19.5,12 C14,14 12,16 12,21 C12,16 10,14 4.5,12 C10,10 12,8 12,3 Z</Geometry>
        <Geometry x:Key="IconWidgets">M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z</Geometry>
        <Geometry x:Key="IconGlobe">M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M3,12 L21,12 M12,3 C8,7.5 8,16.5 12,21 C16,16.5 16,7.5 12,3</Geometry>
        <Geometry x:Key="IconDrop">M12,3 C12,3 5.5,10 5.5,14.5 A6.5,6.5 0 0 0 18.5,14.5 C18.5,10 12,3 12,3 Z</Geometry>
        <Geometry x:Key="IconMic">M12,3.5 A3,3 0 0 1 15,6.5 L15,12 A3,3 0 0 1 9,12 L9,6.5 A3,3 0 0 1 12,3.5 Z M6.5,11 A5.5,5.5 0 0 0 17.5,11 M12,16.5 L12,20.5 M9,20.5 L15,20.5</Geometry>

        <!-- Stroke icon; colour follows the Foreground of the hosting control -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <!-- Appearance picker card. The selected card gets its BorderBrush from code. -->
        <Style x:Key="ThemeCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" BorderThickness="1.5" Background="#14FFFFFF"
                                BorderBrush="{TemplateBinding BorderBrush}" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="0,0,0,14">

        <!-- The island. Anchored to the top of the screen; width/height animate. -->
        <Border x:Name="IslandContainer"
                Width="212" Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,28,28"
                MouseEnter="IslandContainer_MouseEnter"
                MouseLeave="IslandContainer_MouseLeave"
                AllowDrop="True"
                DragEnter="Island_DragEnter"
                DragOver="Island_DragOver"
                DragLeave="Island_DragLeave"
                Drop="Island_Drop">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BgStop1" Color="#F2161D2A" Offset="0"/>
                    <GradientStop x:Name="BgStop2" Color="#F20B0E13" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="IslandBorderBrush" Color="#554C8DFF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.5" ShadowDepth="2" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid ClipToBounds="True">

                <!-- Glass highlight -->
                <Border x:Name="GlassHighlight" IsHitTestVisible="False" CornerRadius="0,0,28,28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#26FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Glass rim: thin light edge, bright at the top, faint at the bottom -->
                <Border x:Name="GlassRim" IsHitTestVisible="False" CornerRadius="0,0,28,28" BorderThickness="1,0,1,1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#70FFFFFF" Offset="0"/>
                            <GradientStop Color="#14FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#2EFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <!-- Collapsed: CPU on the left, temperature on the right (NotchPixel style) -->
                <Grid x:Name="CompactHeader" VerticalAlignment="Top" Height="38" Margin="20,0,20,0">
                    <TextBlock x:Name="CompactTime" Text="--:--" Visibility="Collapsed"/>
                    <Grid x:Name="CompactStats">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="CPU" Foreground="#8CFFFFFF" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactCpuValue" Text="--%" Foreground="White" FontSize="12" FontWeight="Bold"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactRightLabel" Text="RAM" Foreground="#8CFFFFFF" FontSize="11.5" FontWeight="Medium"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="CompactRightValue" Text="--" Foreground="White" FontSize="12" FontWeight="Bold"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CompactMetrics" Text="" Visibility="Collapsed"
                               Foreground="#E6FFFFFF" FontSize="12" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Ellipse x:Name="CompactBellBadge" Width="6" Height="6" Fill="#FF453A"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"
                             IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>

                <!-- Collapsed: incoming notification banner -->
                <Grid x:Name="NotificationBanner" VerticalAlignment="Top" Height="66" Margin="18,0,14,0"
                      Visibility="Collapsed" Cursor="Hand" Background="Transparent"
                      MouseLeftButtonDown="NotificationBanner_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="#1FFFFFFF" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconBell}" Stroke="White"/></Canvas></Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="BannerAppNameText" Text="Notification" Foreground="#B3FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BannerTitleText" Text="Title" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerBodyText" Text="Message" Foreground="#99FFFFFF" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AppleCloseButton}" Click="DismissBanner_Click"
                            VerticalAlignment="Center" Width="22" Height="22"/>
                </Grid>

                <!-- Expanded: navigation + one module at a time -->
                <Grid x:Name="ExpandedRoot" Visibility="Collapsed" Opacity="0" Width="418" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: icon navigation -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="NavStrip" VerticalAlignment="Center" Width="280" Height="28">
                            <Border x:Name="NavIndicator" Width="4" Height="4" CornerRadius="2" Margin="12,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Background>
                                    <SolidColorBrush x:Name="NavIndicatorBrush" Color="#664C8DFF"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorShift" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <RadioButton x:Name="NavMedia" GroupName="IslandNav" Tag="Media"
                                             Style="{StaticResource NavButton}" ToolTip="Media"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconMusic}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavNotifications" GroupName="IslandNav" Tag="Notifications"
                                             Style="{StaticResource NavButton}" ToolTip="Notifications"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconBell}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavClipboard" GroupName="IslandNav" Tag="Clipboard"
                                             Style="{StaticResource NavButton}" ToolTip="Clipboard"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconClipboard}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavSystem" GroupName="IslandNav" Tag="System"
                                             Style="{StaticResource NavButton}" ToolTip="System monitor"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSystem}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavShelf" GroupName="IslandNav" Tag="Shelf"
                                             Style="{StaticResource NavButton}" ToolTip="File shelf"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconShelf}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavReminders" GroupName="IslandNav" Tag="Reminders"
                                             Style="{StaticResource NavButton}" ToolTip="Reminders"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconAlarm}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavAgents" GroupName="IslandNav" Tag="Agents"
                                             Style="{StaticResource NavButton}" ToolTip="AI agents"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSparkle}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavWidgets" GroupName="IslandNav" Tag="Widgets"
                                             Style="{StaticResource NavButton}" ToolTip="Widgets"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconWidgets}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavWeb" GroupName="IslandNav" Tag="Web"
                                             Style="{StaticResource NavButton}" ToolTip="Web drawer"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconGlobe}"/></Canvas></Viewbox></RadioButton>
                                <RadioButton x:Name="NavCalls" GroupName="IslandNav" Tag="Calls"
                                             Style="{StaticResource NavButton}" ToolTip="Calls"
                                             Checked="Nav_Checked"><Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconMic}"/></Canvas></Viewbox></RadioButton>
                            </StackPanel>
                            <Ellipse x:Name="BellBadge" Width="6" Height="6" Fill="#FF453A"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="71,4,0,0"
                                     IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>

                        <Border Width="1" Height="14" Background="#33FFFFFF" Margin="8,0,6,0" VerticalAlignment="Center"/>
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" Width="26" Height="26"
                                FontSize="12" Opacity="0.55" ToolTip="Keep island open" Click="PinButton_Click"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Width="26" Height="26"
                                FontSize="12" ToolTip="Settings" Click="Settings_Click" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Row 1: module views (only one visible) -->
                    <Grid Grid.Row="1" Margin="18,0,18,14">

                        <!-- MEDIA -->
                        <Grid x:Name="ViewMedia" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cover with source badge -->
                            <Grid Grid.Row="0" Grid.Column="0" Width="76" Height="76" Margin="0,0,14,0">
                                <Border x:Name="MediaDefaultArt" CornerRadius="18" Background="#1FFFFFFF">
                                    <TextBlock Text="&#x266B;" FontSize="28" Foreground="#80FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="MediaArtBorder" CornerRadius="18" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="MediaArtBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="MediaSourceBadge" Width="26" Height="26" CornerRadius="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-6,-6" Visibility="Collapsed"
                                        BorderBrush="#33000000" BorderThickness="2">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="BadgeBrush" Color="#FF6B57"/>
                                    </Border.Background>
                                    <TextBlock x:Name="MediaBadgeGlyph" Text="&#x266B;" FontSize="13" Foreground="#1A1A1A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Title, artist, current lyric line -->
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Visibility="Collapsed">
                                    <TextBlock x:Name="MediaStatusBadge" Text="NO MEDIA"/>
                                    <TextBlock x:Name="MediaAppText" Text=""/>
                                </StackPanel>
                                <TextBlock x:Name="MediaTitleText" Text="No media playing"
                                           Foreground="White" FontSize="17" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaArtistText" Text="Start playback in any app"
                                           Foreground="#B3FFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="MediaLyricText" Text="" Visibility="Collapsed"
                                           Foreground="#E6FFFFFF" FontSize="12" FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Transport: plain white glyphs -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MediaPrevButton" Style="{StaticResource TransportButton}"
                                        Content="&#xE892;" Click="MediaPrev_Click"/>
                                <Button x:Name="MediaPlayPauseButton" Style="{StaticResource TransportButton}"
                                        Content="&#xE768;" FontSize="30" Width="46" Height="46"
                                        Click="MediaPlayPause_Click"/>
                                <Button x:Name="MediaNextButton" Style="{StaticResource TransportButton}"
                                        Content="&#xE893;" Click="MediaNext_Click"/>
                            </StackPanel>

                            <!-- Progress line with round knob -->
                            <Grid x:Name="ProgressHit" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  Height="20" Margin="0,10,0,0" Background="Transparent"
                                  MouseLeftButtonDown="ProgressHit_MouseLeftButtonDown"
                                  MouseMove="ProgressHit_MouseMove"
                                  MouseLeftButtonUp="ProgressHit_MouseLeftButtonUp"
                                  LostMouseCapture="ProgressHit_LostMouseCapture"
                                  SizeChanged="ProgressHit_SizeChanged">
                                <Border Height="3" CornerRadius="1.5" Background="#38FFFFFF" VerticalAlignment="Center"/>
                                <Grid x:Name="ProgressFill" Width="0" Height="14"
                                      HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Height="3" CornerRadius="1.5" Background="White" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="ProgressKnob" Width="12" Height="12" Fill="White"
                                             HorizontalAlignment="Right" Margin="0,0,-6,0" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>

                            <!-- Elapsed | lyrics toggle | remaining -->
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#B3FFFFFF" FontSize="11"
                                           FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="LyricsToggleButton" Style="{StaticResource IconButton}"
                                        Content="&#xE8BD;" FontSize="14" Width="28" Height="24"
                                        HorizontalAlignment="Center" Click="LyricsToggle_Click"
                                        ToolTip="Show or hide synced lyrics"/>
                                <TextBlock x:Name="RemainingText" Text="" Foreground="#B3FFFFFF" FontSize="11"
                                           FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- NOTIFICATIONS -->
                        <Grid x:Name="ViewNotifications" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="NotifEmptyText" Text="No notifications" Foreground="#80FFFFFF" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="NotifList" VerticalAlignment="Top"/>
                            </Grid>
                            <DockPanel x:Name="PermissionWarningBanner" Grid.Row="1" Margin="2,2,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource GlassPill}" Content="Open settings" Padding="8,2" FontSize="10"
                                        DockPanel.Dock="Right" Click="OpenWindowsNotificationSettings_Click"/>
                                <TextBlock Text="Windows notification access is restricted" Foreground="#FF9F0A"
                                           FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Grid.Row="2" Margin="2,4,0,0">
                                <Button Style="{StaticResource GlassPill}" Content="Clear all" Padding="10,3" FontSize="10.5" DockPanel.Dock="Right"
                                        Click="ClearNotifications_Click"/>
                                <Button x:Name="QuietModeBtn" Style="{StaticResource GlassPill}" Content="Quiet: Off" Padding="10,3" FontSize="10.5"
                                        DockPanel.Dock="Right" Margin="0,0,6,0" Click="ToggleQuietMode_Click"/>
                                <Button Style="{StaticResource GlassPill}" Content="Send test" Padding="10,3" FontSize="10.5" DockPanel.Dock="Right"
                                        Margin="0,0,6,0" Click="SendTestNotification_Click"/>
                                <TextBlock x:Name="NotificationCountText" Text="0 notices" Foreground="#99FFFFFF" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>

                        <!-- CLIPBOARD -->
                        <Grid x:Name="ViewClipboard" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource GlassPill}" Content="History" Padding="10,3" FontSize="10.5" DockPanel.Dock="Right"
                                        ToolTip="Open the full searchable history" Click="OpenClipboard_Click"/>
                                <Button Style="{StaticResource GlassPill}" Content="Clear" Padding="10,3" FontSize="10.5" DockPanel.Dock="Right"
                                        Margin="0,0,6,0" ToolTip="Clear everything that is not pinned" Click="ClearClipboard_Click"/>
                                <Button x:Name="ClipChipAll" Style="{StaticResource GlassPill}" Content="All" Tag="All" Padding="10,3" FontSize="10.5"
                                        HorizontalAlignment="Left" Click="ClipFilter_Click"/>
                                <Button x:Name="ClipChipText" Style="{StaticResource GlassPill}" Content="Text" Tag="Text" Padding="10,3" FontSize="10.5"
                                        HorizontalAlignment="Left" Margin="4,0,0,0" Opacity="0.5" Click="ClipFilter_Click"/>
                                <Button x:Name="ClipChipImages" Style="{StaticResource GlassPill}" Content="Images" Tag="Images" Padding="10,3" FontSize="10.5"
                                        HorizontalAlignment="Left" Margin="4,0,0,0" Opacity="0.5" Click="ClipFilter_Click"/>
                                <Button x:Name="ClipChipFiles" Style="{StaticResource GlassPill}" Content="Files" Tag="Files" Padding="10,3" FontSize="10.5"
                                        HorizontalAlignment="Left" Margin="4,0,0,0" Opacity="0.5" Click="ClipFilter_Click"/>
                                <Button x:Name="ClipChipPinned" Style="{StaticResource GlassPill}" Content="Pinned" Tag="Pinned" Padding="10,3" FontSize="10.5"
                                        HorizontalAlignment="Left" Margin="4,0,0,0" Opacity="0.5" Click="ClipFilter_Click"/>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <TextBlock x:Name="ClipEmptyText" Text="Copy text, an image or files and it shows up here." Foreground="#80FFFFFF"
                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="ClipList" Orientation="Horizontal" VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock x:Name="ClipboardStatus" Grid.Row="2" Text="Clipboard monitor active" Foreground="#80FFFFFF"
                                       FontSize="10.5" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- SYSTEM -->
                        <Grid x:Name="ViewSystem" Visibility="Collapsed" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="CpuText" Text="--%" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="CPU" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar x:Name="CpuBar" Style="{StaticResource AppleCpuProgressBarStyle}" Maximum="100"/>
                                <DockPanel Margin="0,16,0,5">
                                    <TextBlock x:Name="RamText" Text="--%" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="RAM" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar x:Name="RamBar" Style="{StaticResource AppleRamProgressBarStyle}" Maximum="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="GpuTempText" Text="--" Foreground="#FF9F0A" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock x:Name="GpuNameText" Text="GPU" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="GpuText" Text="--" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="Load" Foreground="#80FFFFFF" FontSize="10.5"/>
                                </DockPanel>
                                <ProgressBar x:Name="GpuBar" Style="{StaticResource AppleGpuProgressBarStyle}" Maximum="100"/>
                                <DockPanel Margin="0,12,0,4">
                                    <TextBlock x:Name="VramText" Text="--" Foreground="White" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="VRAM" Foreground="#80FFFFFF" FontSize="10.5"/>
                                </DockPanel>
                                <ProgressBar x:Name="VramBar" Style="{StaticResource AppleVramProgressBarStyle}" Maximum="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock x:Name="BatteryPercentText" Text="--%" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="BatteryGlyphText" Text="&#x1F50B;" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Battery" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="BatteryStatusText" Text="Power status" Foreground="#80FFFFFF" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"/>
                                <DockPanel Margin="0,16,0,2">
                                    <TextBlock x:Name="NetworkStatusDot" Text="&#x25CF;" Foreground="#30D158" FontSize="9"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetworkNameText" Text="Network" Foreground="#B3FFFFFF" FontSize="11"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                </DockPanel>
                                <TextBlock x:Name="NetworkSpeedText" Text="0 B/s" Foreground="#80FFFFFF" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>


                        <!-- FILE SHELF -->
                        <Grid x:Name="ViewShelf" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,0,8">
                                <Button Style="{StaticResource GlassPill}" Content="Clear" Padding="10,3" FontSize="10.5" DockPanel.Dock="Right"
                                        ToolTip="Remove everything from the shelf (files stay on disk)" Click="ShelfClear_Click"/>
                                <TextBlock x:Name="ShelfCountText" Text="0 FILES" Foreground="#99FFFFFF" FontSize="10.5"
                                           DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Shelf" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <Rectangle Stroke="#40FFFFFF" StrokeThickness="1.2" StrokeDashArray="4 4" RadiusX="16" RadiusY="16"
                                           IsHitTestVisible="False"/>
                                <StackPanel x:Name="ShelfEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Drop files here" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="They wait here until you need them" Foreground="#99FFFFFF" FontSize="10.5"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <WrapPanel x:Name="ShelfPanel" Margin="12,10,12,4" VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>

                        <!-- REMINDERS -->
                        <Grid x:Name="ViewReminders" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReminderInput" Padding="12,7" Background="#1AFFFFFF" BorderBrush="#26FFFFFF"
                                         Foreground="White" CaretBrush="White" KeyDown="ReminderInput_KeyDown"/>
                                <Button x:Name="WhenButton" Grid.Column="1" Style="{StaticResource GlassPill}" Content="No time" Padding="8,7"
                                        Margin="6,0,0,0" MinWidth="72" ToolTip="When it is due (click to change)" Click="WhenCycle_Click"/>
                                <Button x:Name="RepeatButton" Grid.Column="2" Style="{StaticResource GlassPill}" Content="Once" Padding="8,7"
                                        Margin="4,0,0,0" MinWidth="54" ToolTip="Repeat (click to change)" Click="RepeatCycle_Click"/>
                                <Button Grid.Column="3" Style="{StaticResource GlassPill}" Content="Add" Padding="12,7"
                                        Margin="4,0,0,0" Click="AddReminder_Click"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock x:Name="ReminderEmptyText" Text="Nothing to remember. Type above and press Enter."
                                           Foreground="#80FFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="ReminderItems"/>
                            </Grid>
                        </Grid>

                        <!-- AI AGENTS -->
                        <Grid x:Name="ViewAgents" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="4" VerticalAlignment="Center">
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,5,0" Padding="6,10">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,7">
                                            <Border CornerRadius="11" Background="#D97757">
                                                <TextBlock Text="C" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse x:Name="AgentClaudeDot" Width="10" Height="10" Fill="#55FFFFFF" Stroke="#FF0B0E13" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                        </Grid>
                                        <TextBlock Text="Claude" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AgentClaudeText" Text="Checking" Foreground="#99FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="5,0" Padding="6,10">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,7">
                                            <Border CornerRadius="11" Background="#10A37F">
                                                <TextBlock Text="X" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse x:Name="AgentCodexDot" Width="10" Height="10" Fill="#55FFFFFF" Stroke="#FF0B0E13" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                        </Grid>
                                        <TextBlock Text="Codex" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AgentCodexText" Text="Checking" Foreground="#99FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="5,0" Padding="6,10">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,7">
                                            <Border CornerRadius="11" Background="#4C8DFF">
                                                <TextBlock Text="A" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse x:Name="AgentAntigravityDot" Width="10" Height="10" Fill="#55FFFFFF" Stroke="#FF0B0E13" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                        </Grid>
                                        <TextBlock Text="Antigravity" Foreground="White" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AgentAntigravityText" Text="Checking" Foreground="#99FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="5,0,0,0" Padding="6,10">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,7">
                                            <Border CornerRadius="11" Background="#A78BFA">
                                                <TextBlock Text="H" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse x:Name="AgentHermesDot" Width="10" Height="10" Fill="#55FFFFFF" Stroke="#FF0B0E13" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                        </Grid>
                                        <TextBlock Text="Hermes" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AgentHermesText" Text="Checking" Foreground="#99FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <DockPanel Grid.Row="1" Margin="2,10,0,0">
                                <Button Style="{StaticResource GlassPill}" Content="Refresh" Padding="14,4" FontSize="10.5" DockPanel.Dock="Right" Click="RefreshAgents_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="AgentSummaryText" Text="Checking agents" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Detected by process name on this PC" Foreground="#80FFFFFF" FontSize="10.5" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <!-- WIDGETS -->
                        <Grid x:Name="ViewWidgets" Visibility="Collapsed">
                            <UniformGrid Rows="2" Columns="2">

                                <!-- Calendar -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,4,4" Padding="12,8">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="WidgetDayText" Text="--" Foreground="White" FontSize="32" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="WidgetMonthText" Text="" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock x:Name="WidgetDateText" Text="" Foreground="White" FontSize="12.5" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="WidgetClockText" Text="--:--:--" Foreground="#99FFFFFF" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Focus timer ring -->
                                <Border Style="{StaticResource GlassCard}" Margin="4,0,0,4" Padding="12,8">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="54" Height="54" Margin="0,0,12,0">
                                            <Ellipse Margin="2" Stroke="#26FFFFFF" StrokeThickness="4"/>
                                            <Canvas Width="54" Height="54" IsHitTestVisible="False">
                                                <Path x:Name="FocusArc" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                            <Button x:Name="FocusStartButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                    Width="30" Height="30" FontSize="12" Click="StartFocus_Click" ToolTip="Start or pause"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="FOCUS" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock x:Name="FocusTimerText" Text="25:00" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,1,0,3"/>
                                            <Button Style="{StaticResource GlassPill}" Content="Reset" Padding="10,2" FontSize="10"
                                                    HorizontalAlignment="Left" Click="ResetFocus_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Weather -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,4,4,0" Padding="12,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="WeatherCityText" Text="WEATHER" Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="WeatherTempText" Text="--&#xB0;" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                        <TextBlock x:Name="WeatherDescText" Text="Loading" Foreground="#B3FFFFFF" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>

                                <!-- System stats with sparklines -->
                                <Border Style="{StaticResource GlassCard}" Margin="4,4,0,0" Padding="12,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WidgetCpuText" Text="CPU --%" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Canvas Grid.Column="1" Width="90" Height="18" HorizontalAlignment="Left" ClipToBounds="True">
                                                <Polyline x:Name="CpuSpark" Stroke="#0A84FF" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WidgetRamText" Text="RAM --%" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Canvas Grid.Column="1" Width="90" Height="18" HorizontalAlignment="Left" ClipToBounds="True">
                                                <Polyline x:Name="RamSpark" Stroke="#30D158" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>
                        </Grid>

                        <!-- CALLS -->
                        <Grid x:Name="ViewCalls" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0,22,0">
                                <Button x:Name="MicToggleButton" Style="{StaticResource MicDisc}" Content="&#xE720;" Click="MicToggle_Click"
                                        HorizontalAlignment="Center" ToolTip="Mute or unmute the selected microphone">
                                    <Button.Background>
                                        <SolidColorBrush x:Name="MicBrush" Color="#30D158"/>
                                    </Button.Background>
                                </Button>
                                <TextBlock x:Name="MicStateText" Text="Mic on" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock x:Name="MicHintText" Text="Click to mute" Foreground="#99FFFFFF" FontSize="10.5" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SPEAKER" Style="{StaticResource Eyebrow}" Margin="2,0,0,3"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="SpeakerTestButton" Style="{StaticResource GlassPill}" Content="Test" Padding="12,5" DockPanel.Dock="Right"
                                            Margin="6,0,0,0" Click="SpeakerTest_Click"/>
                                    <Border Background="#14FFFFFF" CornerRadius="10" Padding="10,5" Cursor="Hand"
                                            ToolTip="Click to choose the next speaker" MouseLeftButtonUp="SpeakerPick_Click">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock Text="&#x203A;" DockPanel.Dock="Right" Foreground="#99FFFFFF" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpeakerNameText" Text="Default" Foreground="White" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="MICROPHONE" Style="{StaticResource Eyebrow}" Margin="2,0,0,3"/>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="MicTestButton" Style="{StaticResource GlassPill}" Content="Test" Padding="12,5" DockPanel.Dock="Right"
                                            Margin="6,0,0,0" Click="MicTest_Click"/>
                                    <Border Background="#14FFFFFF" CornerRadius="10" Padding="10,5" Cursor="Hand"
                                            ToolTip="Click to choose the next microphone" MouseLeftButtonUp="MicPick_Click">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock Text="&#x203A;" DockPanel.Dock="Right" Foreground="#99FFFFFF" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MicNameText" Text="Default" Foreground="White" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                                <ProgressBar x:Name="MicLevelBar" Style="{StaticResource AppleRamProgressBarStyle}" Maximum="1" Value="0" Margin="2,0,2,6"/>
                                <DockPanel>
                                    <Button Style="{StaticResource GlassPill}" Content="Check camera" Padding="10,3" FontSize="10.5" DockPanel.Dock="Right"
                                            Click="CheckCamera_Click"/>
                                    <TextBlock x:Name="CallStatusText" Text="" Foreground="#99FFFFFF" FontSize="10.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="2,0,8,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <!-- WEB DRAWER -->
                        <Grid x:Name="ViewWeb" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="WebPanel" VerticalAlignment="Top"/>
                            <Grid x:Name="WebAddRow" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WebUrlInput" Padding="10,6" Background="#1AFFFFFF" BorderBrush="#26FFFFFF"
                                         Foreground="White" CaretBrush="White" KeyDown="WebUrlInput_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource GlassPill}" Content="Add" Padding="14,6" Margin="6,0,0,0" Click="WebAdd_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource GlassPill}" Content="Cancel" Padding="12,6" Margin="6,0,0,0" Click="WebCancel_Click"/>
                            </Grid>
                            <TextBlock x:Name="WebHintText" Grid.Row="2" Text="Add any page. Right-click a site to remove it."
                                       Foreground="#80FFFFFF" FontSize="10.5" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- APPEARANCE -->

                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
