<Window x:Class="NextGenIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextGen Island" Width="450" Height="68" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded" Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">
    <Grid Margin="8">
        <!-- Floating Dynamic Island Capsule Container -->
        <Border x:Name="IslandContainer" Background="#08080C" BorderBrush="#252530" BorderThickness="1.2" CornerRadius="24" ClipToBounds="True" MouseEnter="IslandContainer_MouseEnter" MouseLeave="IslandContainer_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.55" ShadowDepth="4" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Compact Normal Island Header (Default Compact View) -->
                <Grid x:Name="CompactHeader" Grid.Row="0" VerticalAlignment="Center" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing Activity Dot & App Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                            <Ellipse Width="14" Height="14" Fill="#30D158" Opacity="0.25"/>
                            <Ellipse Width="8" Height="8" Fill="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXTGEN ISLAND" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Dynamic Companion" Foreground="#8E8E93" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Quick Telemetry & Battery Glance -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="#16161F" CornerRadius="10" Padding="8,3" Margin="8,0">
                        <TextBlock x:Name="CompactMetrics" Text="CPU —%  •  RAM —%" Foreground="#A1A1AA" FontSize="10" FontWeight="Medium"/>
                    </Border>

                    <!-- Right Controls: Notification Bell & Expand Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Notification Bell Trigger -->
                        <Button x:Name="BellButton" Style="{StaticResource ApplePillButton}" Width="28" Height="26"
                                Padding="0" Margin="0,0,6,0" Click="BellButton_Click" ToolTip="Notifications">
                            <Grid>
                                <TextBlock Text="🔔" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Unread / Active dot -->
                                <Ellipse x:Name="BellBadge" Width="6" Height="6" Fill="#FF453A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Expand Button -->
                        <Button x:Name="ExpandButton" Style="{StaticResource ApplePillButton}"
                                Content="v" Click="ExpandButton_Click" Width="28" Height="26" Padding="0" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Dynamic Notification Pop-up Banner (Temporarily replaces compact header on incoming notification) -->
                <Grid x:Name="NotificationBanner" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NotificationBanner_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing App Icon / Notification Icon -->
                    <Border Width="34" Height="34" Background="#1E1628" BorderBrush="#3A254E" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BannerIconText" Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Center: Notification App, Title & Body -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BannerAppNameText" Text="Notification" Foreground="#BF5AF2" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="•  Just now" Foreground="#8E8E93" FontSize="9" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="BannerTitleText" Text="Notification Title" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerBodyText" Text="Notification message body" Foreground="#A1A1AA" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Right: Quick Dismiss Button -->
                    <Button Style="{StaticResource AppleCloseButton}" Click="DismissBanner_Click" VerticalAlignment="Center" Width="22" Height="22"/>
                </Grid>

                <!-- 3. Expanded Dynamic Island Content Panel -->
                <ScrollViewer x:Name="ExpandedScrollViewer" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="ExpandedPanel">

                    
                    <!-- Notification Center Card (Drawer / Queue) -->
                    <Border x:Name="NotificationCard" Background="#13131A" BorderBrush="#22222E" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NOTIFICATIONS" Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
                                    <Border x:Name="NotificationCountBadge" Background="#22162A" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="NotificationCountText" Text="0 NEW" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="QuietModeBtn" Style="{StaticResource ApplePillButton}" Content="Quiet: Off"
                                            Padding="8,2" FontSize="9" Click="ToggleQuietMode_Click" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ApplePillButton}" Content="Clear"
                                            Padding="8,2" FontSize="9" Click="ClearNotifications_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Windows Notification Permission Restriction Banner -->
                            <Border x:Name="PermissionWarningBanner" Background="#241B10" BorderBrush="#4A3416" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <Button Style="{StaticResource ApplePillButton}" Content="Windows Settings" DockPanel.Dock="Right"
                                            Padding="8,3" FontSize="9.5" Click="OpenWindowsNotificationSettings_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="⚠️ Windows Notification Access Restricted" Foreground="#FF9F0A" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="Unpackaged apps require Windows notification permissions." Foreground="#A1A1AA" FontSize="9" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Active / Latest Notification Item -->
                            <Border x:Name="NotificationItemBorder" Background="#181822" BorderBrush="#262636" BorderThickness="1" CornerRadius="12" Padding="10,8">
                                <DockPanel>
                                    <Button Style="{StaticResource AppleCloseButton}" Width="20" Height="20" DockPanel.Dock="Right"
                                            Click="DismissCurrentNotification_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <DockPanel>
                                            <TextBlock x:Name="NotifItemAppText" Text="System" Foreground="#BF5AF2" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="NotifItemTimeText" Text="—" Foreground="#8E8E93" FontSize="9" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <TextBlock x:Name="NotifItemTitleText" Text="No new notifications" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="NotifItemBodyText" Text="Notifications from Windows and system monitors will appear here." Foreground="#8E8E93" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Test Alert Button -->
                            <DockPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource ApplePillButton}" Content="🔔 Send Test Notification"
                                        Padding="10,3" FontSize="9.5" Click="SendTestNotification_Click" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Real Windows Media Controls Card -->
                    <Border Background="#13131A" BorderBrush="#22222E" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border x:Name="MediaDefaultArt" Background="#221528" CornerRadius="10">
                                    <TextBlock x:Name="MediaDefaultIcon" Text="♫" Foreground="#BF5AF2" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="10" ClipToBounds="True">
                                    <Image x:Name="MediaThumbnail" Stretch="UniformToFill" Visibility="Collapsed"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Border x:Name="MediaStatusBorder" Background="#24142E" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock x:Name="MediaStatusBadge" Text="NO MEDIA" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock x:Name="MediaAppText" Text="" Foreground="#8E8E93" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="MediaTitleText" Text="No Media Playing" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaArtistText" Text="No active media session" Foreground="#8E8E93" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MediaPrevButton" Style="{StaticResource AppleMediaButton}" Content="⏮" Click="MediaPrev_Click" FontSize="10" Margin="0,0,5,0" Width="28" Height="28"/>
                                <Button x:Name="MediaPlayPauseButton" Style="{StaticResource AppleMediaButton}" Content="▶" Click="MediaPlayPause_Click" FontSize="11" Width="32" Height="32"/>
                                <Button x:Name="MediaNextButton" Style="{StaticResource AppleMediaButton}" Content="⏭" Click="MediaNext_Click" FontSize="10" Margin="5,0,0,0" Width="28" Height="28"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- System Telemetry: CPU, RAM, NVIDIA GPU, Battery & Network -->
                    <Border Background="#13131A" BorderBrush="#22222E" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="HARDWARE &amp; TELEMETRY" Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="LIVE" Foreground="#30D158" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>

                            <!-- Row 1: CPU & RAM -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="CPU" Foreground="#0A84FF" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CpuText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="CpuBar" Style="{StaticResource AppleCpuProgressBarStyle}" Maximum="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="RAM" Foreground="#BF5AF2" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RamText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="RamBar" Style="{StaticResource AppleRamProgressBarStyle}" Maximum="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Inset Divider -->
                            <Border Height="1" Background="#1D1D28" Margin="0,0,0,8"/>

                            <!-- Row 2: NVIDIA RTX 5050 GPU & VRAM -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="GpuNameText" Text="NVIDIA RTX 5050" Foreground="#30D158" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="GpuTempText" Text="—°C" Foreground="#FF9F0A" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="GPU LOAD" Foreground="#00C7BE" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GpuText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="GpuBar" Style="{StaticResource AppleGpuProgressBarStyle}" Maximum="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="VRAM" Foreground="#FF9F0A" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="VramText" Text="—" Foreground="White" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="VramBar" Style="{StaticResource AppleVramProgressBarStyle}" Maximum="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Inset Divider -->
                            <Border Height="1" Background="#1D1D28" Margin="0,0,0,8"/>

                            <!-- Row 3: Battery & Network Telemetry -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Battery Status -->
                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="BatteryGlyphText" Text="🔋" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="BATTERY" Foreground="#30D158" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BatteryPercentText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <TextBlock x:Name="BatteryStatusText" Text="Power Status" Foreground="#8E8E93" FontSize="9.5"/>
                                </StackPanel>

                                <!-- Network Status -->
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📶" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="NetworkNameText" Text="NETWORK" Foreground="#0A84FF" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NetworkStatusDot" Text="●" Foreground="#30D158" FontSize="8" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="NetworkSpeedText" Text="↓ 0 B/s  •  ↑ 0 B/s" Foreground="#8E8E93" FontSize="9.5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Clipboard Activity Card -->
                    <Border Background="#13131A" BorderBrush="#22222E" BorderThickness="1" CornerRadius="16" Padding="14,11" Margin="0,0,0,10">
                        <DockPanel>
                            <Button Style="{StaticResource ApplePrimaryButton}" Content="History" DockPanel.Dock="Right"
                                    Padding="12,5" FontSize="11" Click="OpenClipboard_Click" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="CLIPBOARD PERSISTENCE" Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="ClipboardStatus" Text="Clipboard monitor active" Foreground="White" FontSize="11" FontWeight="Medium" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Quick Dock & Footer -->
                    <DockPanel Margin="2,2,2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="#30D158" FontSize="8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="SQLite Local Storage" Foreground="#636366" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Style="{StaticResource ApplePillButton}" Content="Settings"
                                    Padding="12,4" FontSize="11" Click="Settings_Click"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
