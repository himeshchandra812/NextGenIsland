<Window x:Class="NextGenIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextGen Island" Width="680" Height="58"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>

        <!-- Icon-only navigation tab -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Hover" CornerRadius="12" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round icon button (prev / next / pin / settings / bell) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Large play / pause disc. Background is set on the element so the accent can animate. -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" CornerRadius="22" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent pill button -->
        <Style x:Key="GlassPill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="0,0,0,14">

        <!-- The island. Anchored to the top of the screen; width/height animate. -->
        <Border x:Name="IslandContainer"
                Width="330"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,28,28"
                MouseEnter="IslandContainer_MouseEnter"
                MouseLeave="IslandContainer_MouseLeave">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BgStop1" Color="#F2161D2A" Offset="0"/>
                    <GradientStop x:Name="BgStop2" Color="#F20B0E13" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="IslandBorderBrush" Color="#554C8DFF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.5" ShadowDepth="2" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid>

                <!-- Glass highlight -->
                <Border IsHitTestVisible="False" CornerRadius="0,0,28,28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#26FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Collapsed: time, summary, bell -->
                <Grid x:Name="CompactHeader" VerticalAlignment="Top" Height="44" Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CompactTime" Text="--:--" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CompactMetrics" Grid.Column="1" Text="CPU --% &#x2022; RAM --%"
                               Foreground="#B3FFFFFF" FontSize="11" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="BellButton" Style="{StaticResource IconButton}" Click="BellButton_Click"
                                Content="&#xE7ED;" ToolTip="Notifications"/>
                        <Ellipse x:Name="CompactBellBadge" Width="7" Height="7" Fill="#FF453A"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0"
                                 IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <!-- Collapsed: incoming notification banner -->
                <Grid x:Name="NotificationBanner" VerticalAlignment="Top" Height="66" Margin="18,0,14,0"
                      Visibility="Collapsed" Cursor="Hand" Background="Transparent"
                      MouseLeftButtonDown="NotificationBanner_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="#1FFFFFFF" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="BannerIconText" Text="&#xE7ED;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="BannerAppNameText" Text="Notification" Foreground="#B3FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BannerTitleText" Text="Title" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerBodyText" Text="Message" Foreground="#99FFFFFF" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AppleCloseButton}" Click="DismissBanner_Click"
                            VerticalAlignment="Center" Width="22" Height="22"/>
                </Grid>

                <!-- Expanded: navigation + one module at a time -->
                <Grid x:Name="ExpandedRoot" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: icon navigation -->
                    <Grid Grid.Row="0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="176" Height="32">
                            <Border x:Name="NavIndicator" Width="44" Height="32" CornerRadius="12"
                                    HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Background>
                                    <SolidColorBrush x:Name="NavIndicatorBrush" Color="#664C8DFF"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorShift" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NavMedia" GroupName="IslandNav" Tag="Media"
                                             Style="{StaticResource NavButton}" Content="&#xE8D6;" ToolTip="Media"
                                             Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavNotifications" GroupName="IslandNav" Tag="Notifications"
                                             Style="{StaticResource NavButton}" Content="&#xE7ED;" ToolTip="Notifications"
                                             Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavClipboard" GroupName="IslandNav" Tag="Clipboard"
                                             Style="{StaticResource NavButton}" Content="&#xE77F;" ToolTip="Clipboard"
                                             Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavSystem" GroupName="IslandNav" Tag="System"
                                             Style="{StaticResource NavButton}" Content="&#xE9D9;" ToolTip="System monitor"
                                             Checked="Nav_Checked"/>
                            </StackPanel>
                            <Ellipse x:Name="BellBadge" Width="7" Height="7" Fill="#FF453A"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="71,4,0,0"
                                     IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,14,0">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                                    Opacity="0.55" ToolTip="Keep island open" Click="PinButton_Click"/>
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                                    ToolTip="Settings" Click="Settings_Click" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: module views (only one visible) -->
                    <Grid Grid.Row="1" Margin="22,2,22,16">

                        <!-- MEDIA -->
                        <Grid x:Name="ViewMedia">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="104" Height="104" VerticalAlignment="Center" Margin="0,0,20,0">
                                <Border x:Name="MediaDefaultArt" CornerRadius="18" Background="#1FFFFFFF">
                                    <TextBlock Text="&#x266B;" FontSize="38" Foreground="#80FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="MediaArtBorder" CornerRadius="18" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="MediaArtBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock x:Name="MediaStatusBadge" Text="NO MEDIA" Foreground="#B3FFFFFF"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="MediaAppText" Text="" Foreground="#80FFFFFF" FontSize="10"
                                               FontWeight="SemiBold" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="MediaTitleText" Grid.Row="1" Text="No media playing"
                                           Foreground="White" FontSize="20" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaArtistText" Grid.Row="2" Text="Start playback in any app"
                                           Foreground="#B3FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="MediaPrevButton" Style="{StaticResource IconButton}"
                                            Content="&#xE892;" FontSize="16" Width="38" Height="38" Click="MediaPrev_Click"/>
                                    <Button x:Name="MediaPlayPauseButton" Style="{StaticResource PlayButton}"
                                            Content="&#xE768;" Margin="8,0" Click="MediaPlayPause_Click">
                                        <Button.Background>
                                            <SolidColorBrush x:Name="PlayBrush" Color="#4C8DFF"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="MediaNextButton" Style="{StaticResource IconButton}"
                                            Content="&#xE893;" FontSize="16" Width="38" Height="38" Click="MediaNext_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- NOTIFICATIONS -->
                        <Grid x:Name="ViewNotifications" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="NOTIFICATIONS" Foreground="#99FFFFFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="NotificationCountText" Text="0 NEW" Foreground="White"
                                               FontSize="10" FontWeight="Bold" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Background="#14FFFFFF" CornerRadius="14" Padding="14,10">
                                    <DockPanel>
                                        <Button Style="{StaticResource AppleCloseButton}" Width="22" Height="22"
                                                DockPanel.Dock="Right" VerticalAlignment="Center"
                                                Click="DismissCurrentNotification_Click"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <DockPanel>
                                                <TextBlock x:Name="NotifItemTimeText" Text="-" Foreground="#80FFFFFF"
                                                           FontSize="10" DockPanel.Dock="Right"/>
                                                <TextBlock x:Name="NotifItemAppText" Text="System" Foreground="#B3FFFFFF"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </DockPanel>
                                            <TextBlock x:Name="NotifItemTitleText" Text="No new notifications"
                                                       Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="NotifItemBodyText" Text="Notifications will appear here."
                                                       Foreground="#99FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DockPanel x:Name="PermissionWarningBanner" Margin="2,8,0,0">
                                    <Button Style="{StaticResource GlassPill}" Content="Open settings" Padding="8,2"
                                            FontSize="10" DockPanel.Dock="Right" Click="OpenWindowsNotificationSettings_Click"/>
                                    <TextBlock Text="Windows notification access is restricted" Foreground="#FF9F0A"
                                               FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="104">
                                <Button x:Name="QuietModeBtn" Style="{StaticResource GlassPill}" Content="Quiet: Off"
                                        Click="ToggleQuietMode_Click"/>
                                <Button Style="{StaticResource GlassPill}" Content="Clear history" Margin="0,6,0,0"
                                        Click="ClearNotifications_Click"/>
                                <Button Style="{StaticResource GlassPill}" Content="Send test" Margin="0,6,0,0"
                                        Click="SendTestNotification_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- CLIPBOARD -->
                        <Grid x:Name="ViewClipboard" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="18" Background="#1FFFFFFF" Margin="0,0,20,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="30" Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CLIPBOARD HISTORY" Foreground="#99FFFFFF" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="ClipboardStatus" Text="Clipboard monitor active" Foreground="White"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Saved locally. Search, pin and copy back from history."
                                           Foreground="#99FFFFFF" FontSize="11.5" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource GlassPill}" Content="Open history"
                                    Padding="16,8" VerticalAlignment="Center" Click="OpenClipboard_Click"/>
                        </Grid>

                        <!-- SYSTEM -->
                        <Grid x:Name="ViewSystem" Visibility="Collapsed" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="CpuText" Text="--%" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="CPU" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar x:Name="CpuBar" Style="{StaticResource AppleCpuProgressBarStyle}" Maximum="100"/>
                                <DockPanel Margin="0,16,0,5">
                                    <TextBlock x:Name="RamText" Text="--%" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="RAM" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar x:Name="RamBar" Style="{StaticResource AppleRamProgressBarStyle}" Maximum="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="GpuTempText" Text="--" Foreground="#FF9F0A" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock x:Name="GpuNameText" Text="GPU" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="GpuText" Text="--" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="Load" Foreground="#80FFFFFF" FontSize="10.5"/>
                                </DockPanel>
                                <ProgressBar x:Name="GpuBar" Style="{StaticResource AppleGpuProgressBarStyle}" Maximum="100"/>
                                <DockPanel Margin="0,12,0,4">
                                    <TextBlock x:Name="VramText" Text="--" Foreground="White" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                                    <TextBlock Text="VRAM" Foreground="#80FFFFFF" FontSize="10.5"/>
                                </DockPanel>
                                <ProgressBar x:Name="VramBar" Style="{StaticResource AppleVramProgressBarStyle}" Maximum="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock x:Name="BatteryPercentText" Text="--%" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="BatteryGlyphText" Text="&#x1F50B;" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Battery" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="BatteryStatusText" Text="Power status" Foreground="#80FFFFFF" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"/>
                                <DockPanel Margin="0,16,0,2">
                                    <TextBlock x:Name="NetworkStatusDot" Text="&#x25CF;" Foreground="#30D158" FontSize="9"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetworkNameText" Text="Network" Foreground="#B3FFFFFF" FontSize="11"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                </DockPanel>
                                <TextBlock x:Name="NetworkSpeedText" Text="0 B/s" Foreground="#80FFFFFF" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
