<Window x:Class="NextGenIsland.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard History" Width="720" Height="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">
    <Grid Margin="12">
        <!-- Floating macOS Card Container -->
        <Border Background="#0E0E12" BorderBrush="#252532" BorderThickness="1.2" CornerRadius="20" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Opacity="0.6" ShadowDepth="6" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Titlebar -->
                    <RowDefinition Height="Auto"/> <!-- Search & Actions Bar -->
                    <RowDefinition Height="*"/>    <!-- Entries List -->
                    <RowDefinition Height="Auto"/> <!-- Footer Status -->
                </Grid.RowDefinitions>

                <!-- macOS Titlebar -->
                <Grid Grid.Row="0" Margin="0,0,0,18" Cursor="Hand" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Clipboard History" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Persistent local SQLite clipboard manager" Foreground="#8E8E93" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- macOS Traffic Light Close Button -->
                    <Button Grid.Column="1" Style="{StaticResource AppleCloseButton}" Click="CloseButton_Click" VerticalAlignment="Center"/>
                </Grid>

                <!-- Search & Actions Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input with Icon -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="32,9,12,9"/>
                        <TextBlock Text="🔍" Foreground="#636366" FontSize="11" Margin="11,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Clear Unpinned Button -->
                    <Button Grid.Column="1" Style="{StaticResource AppleDangerButton}" Content="Clear Unpinned"
                            Padding="14,8" FontSize="11" FontWeight="SemiBold" Click="Clear_Click"/>
                </Grid>

                <!-- Clipboard Entries List -->
                <ListBox x:Name="ItemsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16161E" BorderBrush="#252532" BorderThickness="1"
                                    CornerRadius="14" Padding="14,12">
                                <StackPanel>
                                    <!-- Copied Text Snippet -->
                                    <TextBlock Text="{Binding Text}" Foreground="#F4F4F5" FontSize="12.5"
                                               TextWrapping="Wrap" MaxHeight="75" LineHeight="18" TextTrimming="CharacterEllipsis"/>

                                    <!-- Card Footer with Pin Tag, Timestamp & Action Buttons -->
                                    <DockPanel Margin="0,10,0,0">
                                        <!-- Left metadata -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Pinned Badge -->
                                            <Border CornerRadius="4" Background="#332900" Padding="5,2" Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="★ PINNED" Foreground="#FFD60A" FontSize="9" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Timestamp -->
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MMM dd, yyyy  HH:mm}'}"
                                                       Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Right Action Buttons -->
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Style="{StaticResource ApplePrimaryButton}" Content="Copy" Tag="{Binding}"
                                                    Padding="12,5" FontSize="11" Margin="0,0,6,0" Click="Copy_Click"/>
                                            
                                            <Button Tag="{Binding}" Margin="0,0,6,0" Click="Pin_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ApplePillButton}">
                                                        <Setter Property="Content" Value="Pin"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                <Setter Property="Content" Value="Unpin"/>
                                                                <Setter Property="Foreground" Value="#FFD60A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Style="{StaticResource AppleDangerButton}" Content="Delete" Tag="{Binding}"
                                                    Padding="10,5" FontSize="11" Click="Delete_Click"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer Status Bar -->
                <DockPanel Grid.Row="3" Margin="2,14,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔒" Foreground="#30D158" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Local SQLite Persistence" Foreground="#636366" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CountText" Foreground="#8E8E93" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
