<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NextGenIsland.MainWindow" Title="NextGen Island" Width="560" Height="68" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded" Closing="Window_Closing" FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">
    <Grid Margin="8">
        <!-- Floating Dynamic Island Capsule Container -->
        <Border x:Name="IslandContainer" BorderThickness="1.2" CornerRadius="30" ClipToBounds="True" MouseEnter="IslandContainer_MouseEnter" MouseLeave="IslandContainer_MouseLeave">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                    <GradientStop Color="#B94B7891" Offset="0"/>
                    <GradientStop Color="#A92C5872" Offset="0.48"/>
                    <GradientStop Color="#E52A303B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9BC9E0" Offset="0"/>
                    <GradientStop Color="#547B91" Offset="0.55"/>
                    <GradientStop Color="#A18B6C" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.55" ShadowDepth="4" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,10" x:Name="ExpandedPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact idle island: clock by default, media while a session exists -->
                <Grid x:Name="CompactHeader" Grid.Row="0" VerticalAlignment="Center" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse Fill="#30205A" Opacity="0.9"/>
                        <TextBlock Text="✦" Foreground="#C7A6FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel x:Name="CompactClockPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactClockText" Text="10:45 PM" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactDateText" Text="  SUN, NOV 8" Foreground="#858591" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,3,0,0"/>
                        </StackPanel>
                        <Grid x:Name="CompactMediaPanel" Visibility="Collapsed" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="7" Background="#292238" ClipToBounds="True">
                                <Image x:Name="CompactMediaThumbnail" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                                <TextBlock x:Name="CompactMediaTitle" Text="Now Playing" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CompactMediaArtist" Text="Media session" Foreground="#92929D" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="CompactMediaState" Grid.Column="2" Text="♫" Foreground="#C7A6FF" FontSize="15" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BellButton" Style="{StaticResource ApplePillButton}" Width="28" Height="26" Padding="0" Margin="0,0,6,0" Click="BellButton_Click" ToolTip="Notifications">
                            <Grid>
                                <TextBlock Text="♧" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="BellBadge" Width="6" Height="6" Fill="#FF453A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="ExpandButton" Style="{StaticResource ApplePillButton}" Content="⌄" Click="ExpandButton_Click" Width="28" Height="26" Padding="0" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Dynamic Notification Pop-up Banner (Temporarily replaces compact header on incoming notification) -->
                <Grid x:Name="NotificationBanner" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NotificationBanner_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing App Icon / Notification Icon -->
                    <Border Width="34" Height="34" Background="#1E1628" BorderBrush="#3A254E" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BannerIconText" Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Center: Notification App, Title & Body -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BannerAppNameText" Text="Notification" Foreground="#BF5AF2" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="•  Just now" Foreground="#8E8E93" FontSize="9" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="BannerTitleText" Text="Notification Title" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerBodyText" Text="Notification message body" Foreground="#A1A1AA" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Right: Quick Dismiss Button -->
                    <Button Style="{StaticResource AppleCloseButton}" Click="DismissBanner_Click" VerticalAlignment="Center" Width="22" Height="22"/>
                </Grid>

                <!-- 3. Expanded Dynamic Island Content Panel -->
                <ScrollViewer x:Name="ExpandedScrollViewer" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="300" MaxHeight="480">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#263B4B" BorderBrush="#66869A" BorderThickness="1" CornerRadius="18" Padding="5" Margin="0,0,0,10"><DockPanel><Button Style="{StaticResource ApplePillButton}" Content="⚙" ToolTip="Settings" Padding="10,5" FontSize="13" Click="Settings_Click" DockPanel.Dock="Right" Margin="4,0,0,0"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ApplePillButton}" Content="◉" Tag="notifications" ToolTip="Notifications" Padding="12,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavNotificationsButton"/><Button Style="{StaticResource ApplePillButton}" Content="♫" Tag="media" ToolTip="Media" Padding="12,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavMediaButton"/><Button Style="{StaticResource ApplePillButton}" Content="▥" Tag="system" ToolTip="System" Padding="12,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavSystemButton"/><Button Style="{StaticResource ApplePillButton}" Content="▤" Tag="clipboard" ToolTip="Clipboard" Padding="12,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavClipboardButton"/><Button Style="{StaticResource ApplePillButton}" Content="✓" Tag="reminders" ToolTip="Reminders" Padding="9,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavRemindersButton"/><Button Style="{StaticResource ApplePillButton}" Content="▣" Tag="shelf" ToolTip="File Shelf" Padding="9,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavShelfButton"/><Button Style="{StaticResource ApplePillButton}" Content="◇" Tag="agents" ToolTip="AI Agents" Padding="9,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavAgentsButton"/><Button Style="{StaticResource ApplePillButton}" Content="◎" Tag="widgets" ToolTip="Widgets" Padding="9,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavWidgetsButton"/><Button Style="{StaticResource ApplePillButton}" Content="↗" Tag="web" ToolTip="Web Drawer" Padding="9,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavWebButton"/><Button Style="{StaticResource ApplePillButton}" Content="◐" Tag="themes" ToolTip="Appearance" Padding="9,6" Margin="2,0" FontSize="12" Click="ModuleNavigation_Click" x:Name="NavThemesButton"/></StackPanel></DockPanel></Border><Grid Grid.Row="1" Margin="0,0,0,8"><StackPanel Visibility="Visible" x:Name="ModuleNotificationsView"><Border x:Name="NotificationCard" Background="#263D4D" BorderBrush="#6A8CA1" BorderThickness="1" CornerRadius="22" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NOTIFICATIONS" Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
                                    <Border x:Name="NotificationCountBadge" Background="#22162A" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="NotificationCountText" Text="0 NEW" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="QuietModeBtn" Style="{StaticResource ApplePillButton}" Content="Quiet: Off" Padding="8,2" FontSize="9" Click="ToggleQuietMode_Click" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ApplePillButton}" Content="Clear" Padding="8,2" FontSize="9" Click="ClearNotifications_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Windows Notification Permission Restriction Banner -->
                            <Border x:Name="PermissionWarningBanner" Background="#241B10" BorderBrush="#4A3416" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <Button Style="{StaticResource ApplePillButton}" Content="Windows Settings" DockPanel.Dock="Right" Padding="8,3" FontSize="9.5" Click="OpenWindowsNotificationSettings_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="⚠️ Windows Notification Access Restricted" Foreground="#FF9F0A" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="Unpackaged apps require Windows notification permissions." Foreground="#A1A1AA" FontSize="9" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Active / Latest Notification Item -->
                            <Border x:Name="NotificationItemBorder" Background="#181822" BorderBrush="#262636" BorderThickness="1" CornerRadius="12" Padding="10,8">
                                <DockPanel>
                                    <Button Style="{StaticResource AppleCloseButton}" Width="20" Height="20" DockPanel.Dock="Right" Click="DismissCurrentNotification_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <DockPanel>
                                            <TextBlock x:Name="NotifItemAppText" Text="System" Foreground="#BF5AF2" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="NotifItemTimeText" Text="—" Foreground="#8E8E93" FontSize="9" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <TextBlock x:Name="NotifItemTitleText" Text="No new notifications" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="NotifItemBodyText" Text="Notifications from Windows and system monitors will appear here." Foreground="#8E8E93" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Test Alert Button -->
                            <DockPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource ApplePillButton}" Content="🔔 Send Test Notification" Padding="10,3" FontSize="9.5" Click="SendTestNotification_Click" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    </StackPanel><StackPanel Visibility="Collapsed" x:Name="ModuleMediaView"><Border Background="#13131A" BorderBrush="#22222E" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border x:Name="MediaDefaultArt" Background="#221528" CornerRadius="10">
                                    <TextBlock x:Name="MediaDefaultIcon" Text="♫" Foreground="#BF5AF2" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="10" ClipToBounds="True">
                                    <Image x:Name="MediaThumbnail" Stretch="UniformToFill" Visibility="Collapsed"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Border x:Name="MediaStatusBorder" Background="#24142E" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock x:Name="MediaStatusBadge" Text="NO MEDIA" Foreground="#BF5AF2" FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock x:Name="MediaAppText" Text="" Foreground="#8E8E93" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="MediaTitleText" Text="No Media Playing" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaArtistText" Text="No active media session" Foreground="#8E8E93" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MediaPrevButton" Style="{StaticResource AppleMediaButton}" Content="⏮" Click="MediaPrev_Click" FontSize="10" Margin="0,0,5,0" Width="28" Height="28"/>
                                <Button x:Name="MediaPlayPauseButton" Style="{StaticResource AppleMediaButton}" Content="▶" Click="MediaPlayPause_Click" FontSize="11" Width="32" Height="32"/>
                                <Button x:Name="MediaNextButton" Style="{StaticResource AppleMediaButton}" Content="⏭" Click="MediaNext_Click" FontSize="10" Margin="5,0,0,0" Width="28" Height="28"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </StackPanel><StackPanel Visibility="Collapsed" x:Name="ModuleSystemView"><Border Background="#13131A" BorderBrush="#22222E" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="HARDWARE &amp; TELEMETRY" Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="LIVE" Foreground="#30D158" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>

                            <!-- Row 1: CPU & RAM -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="CPU" Foreground="#0A84FF" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CpuText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="CpuBar" Style="{StaticResource AppleCpuProgressBarStyle}" Maximum="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="RAM" Foreground="#BF5AF2" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RamText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="RamBar" Style="{StaticResource AppleRamProgressBarStyle}" Maximum="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Inset Divider -->
                            <Border Height="1" Background="#1D1D28" Margin="0,0,0,8"/>

                            <!-- Row 2: NVIDIA RTX 5050 GPU & VRAM -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="GpuNameText" Text="NVIDIA RTX 5050" Foreground="#30D158" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="GpuTempText" Text="—°C" Foreground="#FF9F0A" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="GPU LOAD" Foreground="#00C7BE" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GpuText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="GpuBar" Style="{StaticResource AppleGpuProgressBarStyle}" Maximum="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="VRAM" Foreground="#FF9F0A" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="VramText" Text="—" Foreground="White" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="VramBar" Style="{StaticResource AppleVramProgressBarStyle}" Maximum="100"/>
                                </StackPanel>
                            </Grid>

                            <!-- Inset Divider -->
                            <Border Height="1" Background="#1D1D28" Margin="0,0,0,8"/>

                            <!-- Row 3: Battery & Network Telemetry -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Battery Status -->
                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="BatteryGlyphText" Text="🔋" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="BATTERY" Foreground="#30D158" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BatteryPercentText" Text="—%" Foreground="White" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <TextBlock x:Name="BatteryStatusText" Text="Power Status" Foreground="#8E8E93" FontSize="9.5"/>
                                </StackPanel>

                                <!-- Network Status -->
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📶" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="NetworkNameText" Text="NETWORK" Foreground="#0A84FF" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NetworkStatusDot" Text="●" Foreground="#30D158" FontSize="8" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="NetworkSpeedText" Text="↓ 0 B/s  •  ↑ 0 B/s" Foreground="#8E8E93" FontSize="9.5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    </StackPanel><StackPanel Visibility="Collapsed" x:Name="ModuleClipboardView"><Border Background="#13131A" BorderBrush="#22222E" BorderThickness="1" CornerRadius="16" Padding="14,11" Margin="0,0,0,10">
                        <DockPanel>
                            <Button Style="{StaticResource ApplePrimaryButton}" Content="History" DockPanel.Dock="Right" Padding="12,5" FontSize="11" Click="OpenClipboard_Click" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="CLIPBOARD PERSISTENCE" Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="ClipboardStatus" Text="Clipboard monitor active" Foreground="White" FontSize="11" FontWeight="Medium" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    </StackPanel>
<StackPanel x:Name="ModuleRemindersView" Visibility="Collapsed">
 <Border Background="#13131A" BorderBrush="#292936" BorderThickness="1" CornerRadius="15" Padding="13" Margin="0,0,0,10">
  <StackPanel><TextBlock Text="REMINDERS" Foreground="#A8A8B3" FontSize="10" FontWeight="Bold"/><TextBlock Text="Keep small tasks from slipping." Foreground="White" FontSize="13" Margin="0,4,0,10"/><DockPanel><TextBox x:Name="ReminderInput" MinWidth="190" Padding="8" Background="#20202A" Foreground="White" BorderBrush="#3A3A48" CaretBrush="White"/><Button Content="Add" Click="AddReminder_Click" Margin="7,0,0,0" Padding="12,5"/></DockPanel><ItemsControl x:Name="ReminderItems" Margin="0,8,0,0"/></StackPanel>
 </Border>
</StackPanel>
<StackPanel x:Name="ModuleShelfView" Visibility="Collapsed">
 <Border Background="#13131A" BorderBrush="#292936" BorderThickness="1" CornerRadius="15" Padding="13" Margin="0,0,0,10" AllowDrop="True" DragOver="Shelf_DragOver" Drop="Shelf_Drop">
  <StackPanel><TextBlock Text="FILE SHELF" Foreground="#A8A8B3" FontSize="10" FontWeight="Bold"/><TextBlock Text="Drop files here to keep quick access to them." Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock Text="DROP FILES INTO THIS PANEL" Foreground="#8E8E9A" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,8"/><ItemsControl x:Name="ShelfItems"/></StackPanel>
 </Border>
</StackPanel>
<StackPanel x:Name="ModuleAgentsView" Visibility="Collapsed">
 <Border Background="#13131A" BorderBrush="#292936" BorderThickness="1" CornerRadius="15" Padding="13" Margin="0,0,0,10"><StackPanel><TextBlock Text="AI AGENT MONITOR" Foreground="#A8A8B3" FontSize="10" FontWeight="Bold"/><TextBlock Text="Local process detection" Foreground="White" FontSize="13" Margin="0,4,0,8"/><TextBlock x:Name="AgentStatusText" Text="Scanning local processes…" Foreground="#B8B8C4" TextWrapping="Wrap"/><Button Content="Refresh status" Click="RefreshAgents_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,10,0,0"/></StackPanel></Border>
</StackPanel>
<StackPanel x:Name="ModuleWidgetsView" Visibility="Collapsed">
 <Border Background="#13131A" BorderBrush="#292936" BorderThickness="1" CornerRadius="15" Padding="13" Margin="0,0,0,10"><StackPanel><TextBlock Text="WIDGETS" Foreground="#A8A8B3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="WidgetClockText" Text="--:--:--" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="WidgetDateText" Foreground="#A8A8B3" FontSize="11"/><Separator Margin="0,12,0,10"/><TextBlock Text="FOCUS TIMER" Foreground="#A8A8B3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FocusTimerText" Text="25:00" Foreground="White" FontSize="24" Margin="0,5,0,8"/><StackPanel Orientation="Horizontal"><Button Content="Start 25 min" Click="StartFocus_Click" Padding="10,5"/><Button Content="Reset" Click="ResetFocus_Click" Padding="10,5" Margin="6,0,0,0"/></StackPanel></StackPanel></Border>
</StackPanel>
<StackPanel x:Name="ModuleWebView" Visibility="Collapsed">
 <Border Background="#13131A" BorderBrush="#292936" BorderThickness="1" CornerRadius="15" Padding="13" Margin="0,0,0,10"><StackPanel><TextBlock Text="WEB DRAWER" Foreground="#A8A8B3" FontSize="10" FontWeight="Bold"/><TextBlock Text="Open pinned sites in your default browser." Foreground="White" FontSize="12" Margin="0,5,0,10"/><WrapPanel><Button Content="YouTube" Click="OpenYouTube_Click" Padding="10,6" Margin="0,0,6,6"/><Button Content="GitHub" Click="OpenGitHub_Click" Padding="10,6" Margin="0,0,6,6"/><Button Content="Gmail" Click="OpenGmail_Click" Padding="10,6" Margin="0,0,6,6"/><Button Content="Notion" Click="OpenNotion_Click" Padding="10,6" Margin="0,0,6,6"/></WrapPanel></StackPanel></Border>
</StackPanel>
<StackPanel x:Name="ModuleThemesView" Visibility="Collapsed">
