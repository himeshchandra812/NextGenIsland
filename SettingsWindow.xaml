<Window x:Class="NextGenIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="500" Height="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">
    <Grid Margin="12">
        <Border Background="#0E0E12" BorderBrush="#252532" BorderThickness="1.2" CornerRadius="20" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Opacity="0.6" ShadowDepth="6" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Titlebar -->
                    <RowDefinition Height="*"/>    <!-- Settings Groups -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- macOS Titlebar -->
                <Grid Grid.Row="0" Margin="0,0,0,16" Cursor="Hand" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Preferences and hardware integration" Foreground="#8E8E93" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AppleCloseButton}" Click="Close_Click" VerticalAlignment="Center"/>
                </Grid>

                <!-- Settings Scrollable Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Group 1: Notifications & Focus -->
                        <TextBlock Text="NOTIFICATIONS &amp; FOCUS" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" Margin="4,0,0,6"/>
                        <Border Background="#16161E" BorderBrush="#252532" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Enable Notifications -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Smart Notifications" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Display fluid pill banners for system and incoming alerts" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EnableNotifications" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Border Height="1" Background="#252532" Margin="0,10"/>

                                <!-- Quiet Mode -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Quiet Mode (Do Not Disturb)" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Silence notification popups while keeping them in history" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="QuietModeToggle" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Border Height="1" Background="#252532" Margin="0,10"/>

                                <!-- Duration -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Banner Display Duration" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="How long pill notifications remain visible before auto-dismiss" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="DurationCombo" Width="110" Height="26" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="3 seconds" Tag="3"/>
                                        <ComboBoxItem Content="5 seconds" Tag="5"/>
                                        <ComboBoxItem Content="8 seconds" Tag="8"/>
                                        <ComboBoxItem Content="10 seconds" Tag="10"/>
                                    </ComboBox>
                                </DockPanel>

                                <Border Height="1" Background="#252532" Margin="0,10"/>

                                <!-- Windows Permission Help -->
                                <DockPanel>
                                    <Button Style="{StaticResource ApplePillButton}" Content="Windows Privacy Settings"
                                            DockPanel.Dock="Right" Click="OpenNotificationSettings_Click" Padding="10,4" FontSize="10"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Windows Notification Access" Foreground="#FF9F0A" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="Configure Windows toast listener access in System Settings" Foreground="#8E8E93" FontSize="9.5"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Hardware & Telemetry -->
                        <TextBlock Text="HARDWARE &amp; TELEMETRY" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" Margin="4,0,0,6"/>
                        <Border Background="#16161E" BorderBrush="#252532" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Battery Warnings -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Low-Battery Warning Alert" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Post dynamic island notification when battery drops to 20%" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="BatteryWarnings" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Border Height="1" Background="#252532" Margin="0,10"/>

                                <!-- Network Monitoring -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Network Bandwidth Monitor" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Calculate real-time download &amp; upload speed" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="NetworkMonitoring" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Border Height="1" Background="#252532" Margin="0,10"/>

                                <!-- Network Interface Selector -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Active Network Adapter" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Select network interface or auto-detect active adapter" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="InterfaceCombo" Width="140" Height="26" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: General & Clipboard -->
                        <TextBlock Text="SYSTEM &amp; STORAGE" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" Margin="4,0,0,6"/>
                        <Border Background="#16161E" BorderBrush="#252532" BorderThickness="1" CornerRadius="14" Padding="16,12">
                            <StackPanel>
                                <!-- Start with Windows -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Start with Windows" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Automatically launch NextGen Island upon sign-in" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Border Height="1" Background="#252532" Margin="0,10"/>

                                <!-- Pause Clipboard -->
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Pause Clipboard Monitoring" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Temporarily stop recording copied items to SQLite" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="PauseClipboard" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Style="{StaticResource ApplePillButton}" Content="Cancel" Margin="0,0,10,0"
                            Padding="16,8" FontSize="12" Click="Close_Click"/>
                    <Button Style="{StaticResource ApplePrimaryButton}" Content="Save Settings"
                            Padding="18,8" FontSize="12" FontWeight="SemiBold" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
