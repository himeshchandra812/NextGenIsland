<Window x:Class="NextGenIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="540" Height="680"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" KeyDown="Window_KeyDown"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Section label above each card -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C7C88"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,7"/>
        </Style>
        <!-- Rounded card holding a group of rows -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#15151C"/>
            <Setter Property="BorderBrush" Value="#23232E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#23232E"/>
        </Style>

        <!-- Selectable theme swatch -->
        <Style x:Key="ThemeSwatch" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" CornerRadius="12" BorderThickness="1.5" BorderBrush="Transparent"
                                Background="#1A1A24" Padding="8,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#232330"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#0A84FF"/>
                                <Setter TargetName="Frame" Property="Background" Value="#202030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3A3A48" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark drop-down -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Face" Background="#1E1E28" BorderBrush="#2E2E3C" BorderThickness="1" CornerRadius="8">
                            <Path Data="M0,0 L4,4 L8,0" Stroke="#8E8E93" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#272734"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2A2A38"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#1A1A24" BorderBrush="#2E2E3C" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Margin="0,4,10,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" Opacity="0.5" ShadowDepth="3" Direction="270" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#0D0D11" BorderBrush="#23232E" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="6" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar (drag to move) -->
                <Grid Grid.Row="0" Margin="26,22,22,14" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="NextGen Island" Foreground="#7C7C88" FontSize="11.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AppleCloseButton}" Click="Close_Click" VerticalAlignment="Top"/>
                </Grid>

                <!-- Scrollable sections -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0">
                    <StackPanel Margin="26,6,18,6">

                        <!-- GENERAL -->
                        <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Launch NextGen Island when you sign in" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ShrinkInFullscreen" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Shrink in full-screen apps" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="The island becomes a thin line at the top edge while a game or video is full screen. Hover it to open." Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="PauseClipboard" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Pause clipboard history" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Stop recording copied items until you turn this off" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- APPEARANCE -->
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="0,12,0,14">
                                    <TextBlock Text="Island theme" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Wallpaper tints the island from your desktop wallpaper. Glass follows the song that is playing." Style="{StaticResource RowHint}" Margin="0,2,0,10"/>
                                    <UniformGrid Columns="5">
                                        <RadioButton x:Name="ThemeLiquidGlass" GroupName="IslandTheme" Tag="LiquidGlass" Style="{StaticResource ThemeSwatch}" Margin="0,0,4,0">
                                            <StackPanel>
                                                <Border Width="46" Height="30" CornerRadius="10" BorderBrush="#995B9CC2" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E6407A9A" Offset="0"/><GradientStop Color="#F2172A3A" Offset="1"/></LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="Glass" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeWallpaper" GroupName="IslandTheme" Tag="Wallpaper" Style="{StaticResource ThemeSwatch}" Margin="2,0,2,0">
                                            <StackPanel>
                                                <Border x:Name="ThemeWallpaperPreview" Width="46" Height="30" CornerRadius="10" BorderBrush="#4DFFFFFF" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A3A4A" Offset="0"/><GradientStop Color="#161E28" Offset="1"/></LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="Wallpaper" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeBlack" GroupName="IslandTheme" Tag="Black" Style="{StaticResource ThemeSwatch}" Margin="2,0,2,0">
                                            <StackPanel>
                                                <Border Width="46" Height="30" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#000000" Offset="0"/><GradientStop Color="#000000" Offset="1"/></LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="Black" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeGraphite" GroupName="IslandTheme" Tag="Graphite" Style="{StaticResource ThemeSwatch}" Margin="2,0,2,0">
                                            <StackPanel>
                                                <Border Width="46" Height="30" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3A3C45" Offset="0"/><GradientStop Color="#1B1C21" Offset="1"/></LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="Graphite" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeAcrylic" GroupName="IslandTheme" Tag="Acrylic" Style="{StaticResource ThemeSwatch}" Margin="4,0,0,0">
                                            <StackPanel>
                                                <Border Width="46" Height="30" CornerRadius="10" BorderBrush="#4DFFFFFF" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#99557080" Offset="0"/><GradientStop Color="#66222A33" Offset="1"/></LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="Acrylic" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </StackPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="ShapeCombo" Width="150" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Notch" Tag="Notch"/>
                                        <ComboBoxItem Content="Floating pill" Tag="Pill"/>
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Island shape" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Notch hangs from the top edge. Floating pill sits slightly below it." Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="ShowLyrics" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Synced lyrics" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Shows the current line on the Media tab. Sends song title, artist and length to lrclib.net." Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- NOTIFICATIONS -->
                        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="EnableNotifications" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Smart notifications" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Show banners for system and incoming alerts" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="QuietModeToggle" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Quiet mode" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Hide banners but keep everything in the history" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="DurationCombo" Width="110" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <ComboBoxItem Content="3 seconds" Tag="3"/>
                                        <ComboBoxItem Content="5 seconds" Tag="5"/>
                                        <ComboBoxItem Content="8 seconds" Tag="8"/>
                                        <ComboBoxItem Content="10 seconds" Tag="10"/>
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Banner duration" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="How long a banner stays before it hides" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <Button Style="{StaticResource ApplePillButton}" Content="Open Windows settings"
                                            DockPanel.Dock="Right" VerticalAlignment="Center" Click="OpenNotificationSettings_Click"
                                            Padding="12,6" FontSize="11"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Windows notification access" Foreground="#FF9F0A" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="The island reads Windows notifications only if you allow it there" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- SYSTEM -->
                        <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="BatteryWarnings" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Low battery warning" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Show a banner when the battery drops to 20%" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="NetworkMonitoring" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Network speed" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Measure download and upload speed" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Style="{StaticResource Row}">
                                    <ComboBox x:Name="InterfaceCombo" Width="180" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Network adapter" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Pick one, or let the island detect the active adapter" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- WIDGETS -->
                        <TextBlock Text="WIDGETS" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBox x:Name="WeatherCityBox" Width="150" Height="28" DockPanel.Dock="Right" VerticalAlignment="Center"
                                             Padding="10,4" FontSize="11.5" MaxLength="60"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="Weather city" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Used by the Widgets weather tile. A new city name is sent once to open-meteo.com to find its location." Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="WeatherStatus" Foreground="#FF9F0A" FontSize="10.5" Margin="0,-4,0,12"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- ISLAND CARDS -->
                        <TextBlock Text="ISLAND TABS" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="Choose which tabs appear in the island. Media is always on." Style="{StaticResource RowHint}" Margin="0,0,0,8"/>
                                <UniformGrid x:Name="CardSettingsPanel" Columns="2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="26,10,26,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Changes apply when you save." Foreground="#7C7C88" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ApplePillButton}" Content="Cancel" Margin="0,0,10,0"
                                Padding="18,8" FontSize="12" Click="Close_Click"/>
                        <Button Style="{StaticResource ApplePrimaryButton}" Content="Save"
                                Padding="22,8" FontSize="12" FontWeight="SemiBold" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
